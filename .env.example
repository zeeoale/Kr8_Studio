# Kr8 Studio local server
KR8_HOST=127.0.0.1
KR8_PORT=5174
# Comma-separated exact origins for an explicitly configured VPN/reverse proxy.
# Leave empty for the public localhost-only default.
KR8_TRUSTED_ORIGINS=
KR8_SERVER_MODE=0
KR8_DEFAULT_PROJECT=
# Project selection and all project.json access are restricted to this root.
# When empty, Kr8 uses examples/ or the explicitly configured startup project's directory.
KR8_PROJECTS_ROOT=
KR8_EXPORTS_ROOT=
KR8_TKMUSIC_LIBRARY_ROOT=
KR8_FFMPEG_PATH=
KR8_FFPROBE_PATH=
KR8_BROWSER_PATH=
KR8_INTERNAL_ORIGIN=
KR8_CHROME_NO_SANDBOX=0
KR8_HEADLESS_EXPORT_CONCURRENCY=1
KR8_MAX_UPLOAD_MB=25
KR8_MAX_AUDIO_UPLOAD_MB=1024
KR8_AUTH_USER=
KR8_AUTH_PASSWORD=

# Optional local AI services. Kr8 starts normally when these are offline.
KR8_OLLAMA_URL=http://127.0.0.1:11434
KR8_COMFYUI_URL=http://127.0.0.1:8188
KR8_COVER_WORKFLOW_PATH=

# Publisher credential store (outside projects)
KR8_PUBLISH_DATA_DIR=

# Optional TikTok provider
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ENV=sandbox

# Optional YouTube provider
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional Instagram provider and private media bridge
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_BRIDGE_URL=
INSTAGRAM_BRIDGE_TOKEN=
